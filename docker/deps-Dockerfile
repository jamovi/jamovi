        'quantreg', 'reformulas', 'vcd', 'doBy', 'lme4', 'qgraph', 'webshot2', \
        'arm', 'lmerTest', 'pbkrtest', 'rockchalk', 'vcdExtra', 'car', 'mi', \
        'afex', 'sem', 'semPlot'); \
    for (pkg in packages) {               \
        install.packages(                 \
            pkg,                          \
            depends=FALSE,                \
            lib='$R_HOME/library',        \
            INSTALL_opts='--no-data --no-help --no-demo --no-html --no-docs --no-multiarch --clean'); \
        library(pkg, character.only=TRUE); \
    }"

RUN R -e "\
    remotes::install_github( \
        'sjentsch/jmvReadWrite', \
        ref='dcc7ecc5772d24c33ddbe7852a2bd6934bdf7635', \
        lib='$R_HOME/library'); \
    if ( ! requireNamespace('jmvReadWrite')) \
        quit(status = 1); \
    "
